[Unit]
Description=Rayakala landing page for rayakala.ink
After=network.target

[Service]
Type=simple
User=rayakala-landing
Group=rayakala-landing
WorkingDirectory=/var/lib/rayakala-landing
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/rayakala-landing
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rayakala-landing

[Install]
WantedBy=multi-user.target
